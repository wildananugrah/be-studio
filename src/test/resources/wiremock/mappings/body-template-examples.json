        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "text/xml; charset=UTF-8"
        },
        "body": "<?xml version=\"1.0\" encoding=\"UTF-8\"?>\n<soapenv:Envelope xmlns:soapenv=\"http://schemas.xmlsoap.org/soap/envelope/\" xmlns:q0=\"http://service.example.com/core\"><soapenv:Body><q0:transactionResponse><response><responseCode>00</responseCode><responseMessage>Transfer accepted</responseMessage><content><transferId>TRF-20261009-0001</transferId><status>POSTED</status></content></response></q0:transactionResponse></soapenv:Body></soapenv:Envelope>"
      }
