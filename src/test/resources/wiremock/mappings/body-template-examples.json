          }
        },
        "bodyPatterns": [
          {
            "matchesJsonPath": "$[?(@.header.channel == 'MOBILE')]"
          },
          {
            "matchesJsonPath": "$.payload[?(@.amount == 150000)]"
          },
          {
            "matchesJsonPath": "$.payload.recipients[0]"
          }
        ]
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "status": "SENT",
