<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- Downstream systems configured in the database. Rows win over gateway.target-systems in application.yml. -->
    <changeSet id="003-gw-target-system" author="json-gateway">
        <createTable tableName="${tbl.target_system}">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="${tbl.target_system}_PK" nullable="false"/>
            </column>
            <column name="code" type="varchar(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="${tbl.target_system}_UK1"/>
            </column>
            <!-- scheme://host:port[/base-path]; may contain ${ENV_VAR} placeholders -->
            <column name="base_url" type="varchar(500)">
                <constraints nullable="false"/>
            </column>
            <column name="connect_timeout_ms" type="int"/>
            <column name="read_timeout_ms" type="int"/>
            <column name="enabled" type="boolean" defaultValueBoolean="true">
                <constraints nullable="false"/>
            </column>
        </createTable>
    </changeSet>

    <changeSet id="003-gw-target-system-header" author="json-gateway">
        <createTable tableName="${tbl.target_system_header}">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="${tbl.target_system_header}_PK" nullable="false"/>
            </column>
            <column name="target_code" type="varchar(100)">
                <constraints nullable="false" foreignKeyName="${tbl.target_system_header}_FK1"
                             referencedTableName="${tbl.target_system}" referencedColumnNames="code"
                             deleteCascade="true"/>
            </column>
            <column name="header_name" type="varchar(200)">
                <constraints nullable="false"/>
            </column>
            <!-- may contain ${ENV_VAR} placeholders, e.g. for API keys -->
            <column name="header_value" type="varchar(4000)">
                <constraints nullable="false"/>
            </column>
        </createTable>
        <addUniqueConstraint tableName="${tbl.target_system_header}" columnNames="target_code, header_name"
                             constraintName="${tbl.target_system_header}_UK1"/>
    </changeSet>
</databaseChangeLog>
