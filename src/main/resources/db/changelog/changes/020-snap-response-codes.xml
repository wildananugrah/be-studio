    <!--
        The SNAP response code catalog (lookup SNAP_RESPONSE_CODE), loaded in every environment: source_value is
        "<HTTP status>.<case code>", target_value the responseMessage, with {field name} / [reason] placeholders that
        snapErrorHandler fills in. Edit the messages in Gateway Studio > Lookups.

        SNAP_GATEWAY_ERROR maps the gateway's own errors (by error type) to a SNAP code. The same defaults are built
        into snapErrorHandler; the rows are here so that they can be seen and changed.
    -->
    <changeSet id="020-snap-response-codes" author="json-gateway">
        <insert tableName="${tbl.lookup_entry}">
            <column name="lookup_code" value="SNAP_RESPONSE_CODE"/><column name="source_value" value="200.00"/><column name="target_value" value="Successful"/>
