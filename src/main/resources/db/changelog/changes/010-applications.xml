<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Applications: every flow belongs to one (gw_flow.application_code), so an application's whole configuration
        (its flows, steps and mapping rules, plus the shared target systems, lookups, schemas and storages they use)
        can be exported and moved to another environment. Flows without one belong to DEFAULT.
    -->
    <changeSet id="010-gw-application" author="json-gateway">
        <createTable tableName="${tbl.application}">
            <column name="id" type="bigint" autoIncrement="true">
                <constraints primaryKey="true" primaryKeyName="${tbl.application}_PK" nullable="false"/>
            </column>
            <column name="code" type="varchar(100)">
                <constraints nullable="false" unique="true" uniqueConstraintName="${tbl.application}_UK1"/>
            </column>
            <column name="name" type="varchar(200)"/>
            <column name="description" type="varchar(1000)"/>
        </createTable>
        <insert tableName="${tbl.application}">
            <column name="code" value="DEFAULT"/>
            <column name="name" value="Default application"/>
            <column name="description" value="Flows created before applications existed"/>
        </insert>
        <addColumn tableName="${tbl.flow}">
            <column name="application_code" type="varchar(100)" defaultValue="DEFAULT">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>
</databaseChangeLog>
