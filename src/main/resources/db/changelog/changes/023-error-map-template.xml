<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
            http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!--
        Error map rules can match a field as a template ("match": "template" in error_map_where: {name} in the entry's
        text matches any text). error_map_fill: the placeholders in the output are filled with what the templates
        captured under the same names (null / false: the output as it is in the map). error_map_index: which of
        several matching entries to take, ordered by fixed template text, most first, then map order (null = 0).
    -->
    <changeSet id="023-gw-error-map-fill" author="json-gateway">
        <addColumn tableName="${tbl.mapping_rule}">
            <column name="error_map_fill" type="boolean"/>
            <column name="error_map_index" type="int"/>
        </addColumn>
    </changeSet>
</databaseChangeLog>
