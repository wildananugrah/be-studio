# Gateway Studio assistant (copy to .env; .env is git-ignored). The endpoint must serve the Anthropic Messages API.
#
# Anthropic directly:
#   AI_BASE_URL=https://api.anthropic.com      AI_MODEL=claude-opus-5-5          AI_AUTH_TYPE=api-key
# OpenRouter (sk-or-v1-... keys):
#   AI_BASE_URL=https://openrouter.ai/api      AI_MODEL=anthropic/claude-sonnet-5.5   AI_AUTH_TYPE=bearer
# A gateway/proxy: its base URL, the model name it exposes, and the key it issued to you.
AI_BASE_URL=https://api.anthropic.com
AI_AUTH_KEY=your-api-key
AI_MODEL=claude-opus-5-5
# auto (default: x-api-key for sk-ant-api keys, Bearer otherwise) | bearer | api-key
# AI_AUTH_TYPE=auto
# Optional: low | medium | high | xhigh | max (leave unset if your endpoint or model does not support effort)
# AI_EFFORT=medium
